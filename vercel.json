{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{views/**,public/**,db/**,node_modules/@sparticuz/chromium/bin/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/engine",
      "schedule": "0 1 * * *"
    }
  ]
}
