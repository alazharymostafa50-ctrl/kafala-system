# ============ إعدادات نظام إدارة كفالة الأيتام ============
# بيئة التشغيل: production في الخادم الفعلي
NODE_ENV=production
PORT=3000
# اترك 127.0.0.1 خلف Nginx (لا تفتح المنفذ للإنترنت مباشرة)
HOST=127.0.0.1
# المنطقة الزمنية للجمعية (تؤثر على «اليوم» في حساب الأعمار والفترات)
APP_TZ=Africa/Cairo

# اتصال قاعدة البيانات PostgreSQL
DATABASE_URL=postgres://kafala_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/kafala

# مفتاح الجلسات: 64 حرفًا عشوائيًا على الأقل
# أنشئه بالأمر: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# مدة الجلسة بالدقائق (تتجدد مع النشاط)
SESSION_MINUTES=120

# مجلد التخزين الخاص (المستندات، التقارير المعتمدة، النسخ الاحتياطية) — خارج أي مجلد عام
STORAGE_DIR=/var/lib/kafala/storage

# مسار متصفح Chromium لإنتاج ملفات PDF (مثال لأوبونتو: /usr/bin/chromium أو /usr/bin/chromium-browser)
CHROME_PATH=/usr/bin/chromium

# مفتاح تشفير النسخ الاحتياطية — احفظه في مكان آمن خارج الخادم؛ بدونه لا يمكن الاستعادة
BACKUP_KEY=
