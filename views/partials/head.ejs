<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> — <%= org.system_name %></title>
<link rel="icon" href="/static/img/icon-32.png" type="image/png">
<link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png">
<meta name="theme-color" content="#054834">
<link rel="stylesheet" href="/static/css/app.css?v=<%= typeof v !== "undefined" ? v : 1 %>">
</head>
<body>
<div class="shell">
<aside class="sidebar" id="sidebar">
  <div class="brand">
    <img src="<%= org.logo %>" alt="شعار الجمعية">
    <div><b><%= org.name %></b><% if (org.registration) { %><span class="reg"><%= org.registration %></span><% } %><span><%= org.system_name %></span></div>
  </div>
  <nav class="nav">
    <% const nav = (href, ic, text, perm, extra) => { if (perm && !can(perm)) return ''; const on = (href === '/' ? path === '/' : path.startsWith(href)); return `<a href="${href}" class="${on ? 'on' : ''}" title="${text}">${icon(ic)}<span>${text}</span>${extra || ''}</a>`; } %>
    <%- nav('/', 'home', 'الرئيسية', 'dashboard.view') %>
    <div class="grp">الأسر والكفلاء</div>
    <%- nav('/families', 'family', 'الأسر والأيتام', 'families.view') %>
    <%- nav('/eligibility', 'shield', 'مراجعة الاستحقاق', 'eligibility.view') %>
    <%- nav('/sponsors', 'sponsor', 'الكفلاء', 'sponsors.view') %>
    <div class="grp">المالية</div>
    <%- nav('/donations', 'donation', 'التبرعات', 'donations.view') %>
    <%- nav('/expenses', 'expense', 'المصروفات', 'expenses.view') %>
    <%- nav('/entitlements', 'calendar', 'الصرف الشهري', 'entitlements.view') %>
    <% if (can('reports.export')) { %><%- nav('/statements', 'doc', 'أرشيف الكشوف', 'entitlements.view') %><% } %>
    <% if (can('families.archive') || can('sponsors.edit')) { %><%- nav('/trash', 'trash', 'سلة المحذوفات') %><% } %>
    <%- nav('/finance', 'wallet', 'الأرصدة', 'finance.view') %>
    <%- nav('/reports', 'report', 'التقارير والطباعة', 'reports.view') %>
    <div class="grp">النظام</div>
    <%- nav('/notifications', 'bell', 'التنبيهات', null, notifCount ? `<i class="badge-n">${notifCount}</i>` : '') %>
    <%- nav('/import', 'import', 'استيراد من Excel', 'import.run') %>
    <%- nav('/admin/users', 'users', 'المستخدمون والأدوار', 'users.manage') %>
    <%- nav('/admin/settings', 'settings', 'الإعدادات', 'settings.manage') %>
    <%- nav('/admin/audit', 'log', 'سجل التدقيق', 'audit.view') %>
  </nav>
</aside>
<div class="overlay" data-close-nav></div>
<div class="main">
  <header class="topbar">
    <button class="iconbtn" type="button" data-toggle-nav aria-label="القائمة"><%- icon('menu') %></button>
    <% if (can('families.view')) { %>
    <form class="qs" action="/families" method="get" role="search">
      <input type="search" name="q" placeholder="بحث سريع: رقم الملف، الاسم، الجوال" aria-label="بحث عن أسرة">
    </form>
    <% } %>
    <div class="spacer"></div>
    <a class="iconbtn" href="/notifications" title="التنبيهات"><%- icon('bell') %><% if (notifCount) { %><span class="dot"><%= notifCount %></span><% } %></a>
    <div class="userchip">
      <span class="av"><%= user.full_name.trim().charAt(0) %></span>
      <span class="nm"><b><%= user.full_name %></b><br><span class="muted small"><%= user.roles.map(r => r.name).join('، ') || 'بدون دور' %></span></span>
    </div>
    <a class="iconbtn" href="/account/password" title="كلمة المرور والأمان"><%- icon('key') %></a>
    <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="iconbtn" title="تسجيل الخروج"><%- icon('logout') %></button></form>
  </header>
  <main class="content">
  <% if (flash) { %><div class="alert <%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
