<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>تسجيل الدخول — <%= org.system_name %></title>
<link rel="icon" href="/static/img/icon-32.png" type="image/png">
<link rel="stylesheet" href="/static/css/app.css?v=<%= typeof v !== "undefined" ? v : 1 %>">
</head>
<body>
<div class="authpage">
  <div class="authcard">
    <img src="<%= org.logo %>" alt="شعار الجمعية">
    <h1><%= org.system_name %></h1>
    <div class="muted small"><b><%= org.name %></b><% if (org.registration) { %> <span class="regtxt"><%= org.registration %></span><% } %><% if (org.subtitle) { %><br><%= org.subtitle %><% } %></div>
    <% if (flash) { %><div class="alert <%= flash.type %>" style="margin-top:1rem"><%= flash.msg %></div><% } %>
    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% if (step === 'totp') { %>
        <div class="field"><label for="code">رمز التحقق من تطبيق المصادقة</label>
          <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus></div>
        <button class="btn" type="submit">تحقق ودخول</button>
      <% } else { %>
        <div class="field"><label for="username">اسم المستخدم</label>
          <input id="username" name="username" type="text" autocomplete="username" required autofocus dir="ltr"></div>
        <div class="field"><label for="password">كلمة المرور</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required dir="ltr"></div>
        <label class="check remember"><input type="checkbox" name="remember" value="1" checked> تذكرني على هذا الجهاز لمدة 30 يومًا</label>
        <p class="muted small" style="margin:-.4rem 0 .8rem">لا تفعّلها على جهاز مشترك أو عام.</p>
        <button class="btn" type="submit">دخول</button>
        <p class="small" style="margin:.8rem 0 0;text-align:center">نسيت كلمة المرور؟ الموظف يطلب إعادة التعيين من مدير النظام، ومدير النظام يستخدم <a href="/recover">استعادة حساب المدير</a>.</p>
      <% } %>
    </form>
    <p class="muted small" style="margin-top:1.2rem">نظام داخلي مخصص لموظفي الجمعية. جميع العمليات مسجلة.</p>
  </div>
</div>
<script src="/static/js/app.js?v=<%= typeof v !== "undefined" ? v : 1 %>"></script>
</body>
</html>
