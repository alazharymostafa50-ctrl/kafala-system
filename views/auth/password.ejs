<%- include('../partials/head', { title }) %>
<div class="pagehead"><div><h1>كلمة المرور والأمان</h1><p>غيّر كلمة المرور أو فعّل المصادقة الثنائية لحسابك.</p></div>
<a class="btn sec" href="/account/2fa"><%- icon('shield') %> المصادقة الثنائية <%= user.totp_enabled ? '(مفعلة)' : '' %></a></div>
<% if (user.must_change_password) { %><div class="alert warning">يجب تغيير كلمة المرور المؤقتة قبل متابعة استخدام النظام.</div><% } %>
<div class="card" style="max-width:520px">
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field" style="margin-bottom:.8rem"><label>كلمة المرور الحالية</label><input type="password" name="current_password" required autocomplete="current-password" dir="ltr"></div>
    <div class="field" style="margin-bottom:.8rem"><label>كلمة المرور الجديدة</label><input type="password" name="new_password" required minlength="10" autocomplete="new-password" dir="ltr"><div class="hint">10 أحرف على الأقل، تحتوي على حروف وأرقام.</div></div>
    <div class="field" style="margin-bottom:.8rem"><label>تأكيد كلمة المرور الجديدة</label><input type="password" name="confirm_password" required autocomplete="new-password" dir="ltr"></div>
    <button class="btn">حفظ كلمة المرور</button>
  </form>
</div>
<%- include('../partials/foot') %>
